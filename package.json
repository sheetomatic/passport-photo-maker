{
  "name": "passport-photo-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only passport photo maker: exact 35 x 45 mm photos on an A4 sheet with adjustable quantity and gaps.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:all": "node --test tests/unit/*.test.mjs && node tests/e2e.mjs",
    "dev:lan": "node server.mjs --host 0.0.0.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.10.0"
  },
  "imports": {
    "#app/geometry": "./js/geometry.js",
    "#app/image-processing": "./js/image-processing.js",
    "#app/crop": "./js/crop.js",
    "#app/face-detect": "./js/face-detect.js",
    "#app/background": "./js/background.js",
    "#app/pdf": "./js/pdf.js",
    "#app/print": "./js/print.js"
  }
}
